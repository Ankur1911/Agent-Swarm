# ---------------------------------------------------------------------
# Required – the service will refuse to start without these.
# ---------------------------------------------------------------------
API_ENDPOINT=https://your-llm-provider.example.com/v1/chat/completions
API_KEY=sk-your-api-key

# ---------------------------------------------------------------------
# Optional – leave unset for local development. Features that depend on
# them (Slack alerts, news lookup, support email) degrade gracefully.
# ---------------------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# NEWS_API_KEY=pub_xxxxxxxxxxxxxxxx

# --- SMTP group: set ALL of these or NONE of them --------------------
# SUPPORT_EMAIL=support@example.com
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SENDER_EMAIL=bot@example.com
# SENDER_PASSWORD=app-specific-password

# ---------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------
# ENVIRONMENT=development
